# Supabase Auth. Required for sign-in. Never expose the service role to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Postgres connection used by Drizzle.
DATABASE_URL=postgres://planner:planner@127.0.0.1:54329/planner

# Only this address may use the private application.
ALLOWED_EMAIL=you@example.com

# Protects Vercel Cron and manual job triggers.
CRON_SECRET=replace-with-a-long-random-string

# 32-byte key, base64-encoded, for Google refresh tokens.
TOKEN_ENCRYPTION_KEY=

# openai | anthropic | mock
# mock is a deterministic local adapter and is labeled as such in the UI.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional Google Calendar integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
